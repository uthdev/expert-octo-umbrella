# Service Configuration
SERVICE_NAME=school-management-api
ENV=development

# Server Ports
USER_PORT=5111

# Database Configuration
MONGO_URI=mongodb://localhost:27017/school-management-api

# JWT Secrets (Generate strong secrets for production)
LONG_TOKEN_SECRET=your-long-token-secret-here-min-32-chars
SHORT_TOKEN_SECRET=your-short-token-secret-here-min-32-chars
NACL_SECRET=your-nacl-secret-here-min-32-chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100